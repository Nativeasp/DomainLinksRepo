DOMAINLINKS_ENV=development
DOMAINLINKS_API_HOST=127.0.0.1
DOMAINLINKS_API_PORT=5056

# SQL Server
DOMAINLINKS_SQL_SERVER=RICHARDBASQB378
DOMAINLINKS_SQL_DATABASE=DomainLinks
DOMAINLINKS_SQL_DRIVER=ODBC Driver 18 for SQL Server
DOMAINLINKS_SQL_TRUSTED_CONNECTION=true
DOMAINLINKS_SQL_TRUST_SERVER_CERTIFICATE=true

# Providers
DOMAINLINKS_DEFAULT_LLM_PROVIDER=ollama
DOMAINLINKS_OLLAMA_BASE_URL=http://127.0.0.1:11434
DOMAINLINKS_OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
DOMAINLINKS_OLLAMA_CHAT_MODEL=llama3.1:8b
DOMAINLINKS_OLLAMA_TITLE_MODEL=llama3.1:8b
DOMAINLINKS_LMSTUDIO_BASE_URL=http://127.0.0.1:1234
