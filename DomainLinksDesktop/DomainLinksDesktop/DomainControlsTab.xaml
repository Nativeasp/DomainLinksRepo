<UserControl x:Class="DomainLinksDesktop.DomainControlsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DomainLinksDesktop"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition x:Name="BranchControlsRow" Height="*" MinHeight="150" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#263746"
                           Text="Controls" />
                <TextBlock x:Name="BranchSummaryTextBlock"
                           Margin="0,2,0,0"
                           Foreground="#5B6770"
                           FontSize="11"
                           Text="Select a domain, then open this tab." />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="RefreshControlsButton"
                    Width="86"
                    Height="32"
                    Click="RefreshControlsButton_OnClick"
                    Content="Refresh" />
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#D6D0C4"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold"
                           Foreground="#263746"
                           FontSize="12"
                           Text="Controls In Scope" />
                <DataGrid Grid.Row="2"
                          x:Name="BranchControlsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          ItemsSource="{Binding DisplayControls, RelativeSource={RelativeSource AncestorType=local:DomainControlsTab}}"
                          SelectionMode="Single"
                          SelectionChanged="BranchControlsDataGrid_OnSelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="FontStyle" Value="Normal" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentDomainControl}" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                    <Setter Property="Foreground" Value="#5B6770" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrentDomainControl}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                    <Setter Property="FontStyle" Value="Italic" />
                                    <Setter Property="Opacity" Value="0.9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Control"
                                            Width="*"
                                            MinWidth="260"
                                            Binding="{Binding DisplayName}" />
                        <DataGridTemplateColumn Header="Type"
                                                Width="190">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip" Value="{Binding ControlTypeDescription}" />
                                    <Setter Property="ToolTipService.ShowDuration" Value="30000" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ControlTypeName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status"
                                            Width="92"
                                            Binding="{Binding Status}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3"
                      Height="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#D6D0C4"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      ShowsPreview="True" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SuggestionsColumn" Width="1.15*" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0"
                          MinHeight="260">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#263746"
                                   FontSize="12"
                                   Text="Suggest Controls" />
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="95" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.ColumnSpan="3">
                                <TextBlock Foreground="#5B6770"
                                           FontSize="11"
                                           Text="Control Type" />
                                <ComboBox x:Name="ControlTypeComboBox"
                                          Margin="0,3,0,0"
                                          Height="30"
                                          SelectionChanged="ControlTypeComboBox_OnSelectionChanged"
                                          SelectedValuePath="Code">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Foreground="#5B6770"
                                           FontSize="11"
                                           Text="Idea / Focus" />
                                <TextBox x:Name="IdeaTextBox"
                                         Margin="0,3,0,0"
                                         MinHeight="86"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="7,5" />
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="2">
                                <TextBlock Foreground="#5B6770"
                                           FontSize="11"
                                           Text="Count" />
                                <ComboBox x:Name="CountComboBox"
                                          Margin="0,3,0,0"
                                          Height="30"
                                          SelectedIndex="2" />
                            </StackPanel>

                            <StackPanel Grid.Row="4"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="PromptPreviewButton"
                                        Width="110"
                                        Height="30"
                                        Margin="0,0,8,0"
                                        Click="PromptPreviewButton_OnClick"
                                        Content="Prompt Preview" />
                                <Button x:Name="GenerateSuggestionsButton"
                                        Width="96"
                                        Height="30"
                                        Click="GenerateSuggestionsButton_OnClick"
                                        Background="#18344A"
                                        Foreground="#FFFFFF"
                                        Content="Generate" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#D6D0C4"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#263746"
                               FontSize="12"
                               Text="Detail" />
                    <Border Grid.Row="2"
                            Margin="0,0,0,2"
                            Background="#F8F6F1"
                            BorderBrush="#E2DBCF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8">
                            <TextBlock x:Name="DraftDetailTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#000000" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="RejectOrDeleteButton"
                                Width="90"
                                Height="30"
                                Margin="0,0,8,0"
                                Click="RejectOrDeleteButton_OnClick"
                                IsEnabled="False"
                                Content="Remove" />
                        <Button x:Name="SqlPreviewButton"
                                Width="96"
                                Height="30"
                                Margin="0,0,8,0"
                                Click="SqlPreviewButton_OnClick"
                                IsEnabled="False"
                                Content="SQL Preview" />
                        <Button x:Name="RunInsertButton"
                                Width="92"
                                Height="30"
                                Click="RunInsertButton_OnClick"
                                IsEnabled="False"
                                Background="#18344A"
                                Foreground="#FFFFFF"
                                Content="Run Insert" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5"
                   x:Name="ControlsStatusTextBlock"
                   Margin="0,8,0,0"
                   Foreground="#5B6770"
                   FontSize="12"
                   Text="Controls idle." />
    </Grid>
</UserControl>
