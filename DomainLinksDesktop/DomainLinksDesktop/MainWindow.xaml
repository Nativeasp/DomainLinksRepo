<Window x:Class="DomainLinksDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DomainLinksDesktop"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="DomainLinks Desktop"
        Height="820"
        Width="1420"
        MinHeight="720"
        MinWidth="1180"
        Background="#F3F1EC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F8F3EA"
                BorderBrush="#D6D0C4"
                BorderThickness="1"
                CornerRadius="6"
                Height="70"
                ClipToBounds="True">
            <wv2:WebView2 x:Name="ShellMenuWebView" />
        </Border>

        <Border Grid.Row="2"
                x:Name="TopPanelBorder"
                Background="#18344A"
                CornerRadius="6"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="#F7F3EA"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="DomainLinks" />
                </StackPanel>
                <Grid Grid.Column="1"
                      Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="#F7F3EA"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Backend Status" />
                    <TextBox x:Name="BackendStatusTextBox"
                             Grid.Row="1"
                             Margin="0,4,0,0"
                             Foreground="#F7F3EA"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             FontSize="14"
                             Padding="0"
                             Text="Checking backend..." />
                    <Border x:Name="BackendDetailHost"
                            Grid.Row="2"
                            Background="Transparent">
                        <TextBox x:Name="BackendDetailTextBox"
                                 Margin="0,2,0,0"
                                 Foreground="#D7E2EA"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Padding="0"
                                 MinHeight="22" />
                    </Border>
                </Grid>
                <Button Grid.Column="2"
                        x:Name="TopPanelToggleButton"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="TopPanelToggleButton_OnClick"
                        Background="#FFFFFF"
                        BorderBrush="#4E4E4E"
                        BorderThickness="1"
                        Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="12"
                             Height="12">
                        <Path x:Name="TopPanelToggleIcon"
                              Stroke="#222222"
                              StrokeThickness="2.2"
                              Data="M 2 10 L 7 4 L 12 10" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="280" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="320" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FAF8F3"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Border Background="#EAF4FF"
                                BorderBrush="#18344A"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#18344A"
                                           Text="Projects And Chats" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#365268"
                                           FontSize="12"
                                           Text="Short-term memory scopes and the collections we chat against" />
                                <StackPanel Margin="0,8,0,0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,14,0">
                                        <Button x:Name="AddRootButton"
                                                Width="24"
                                                Height="22"
                                                Margin="0,0,6,0"
                                                Padding="0"
                                                Click="AddRootButton_OnClick"
                                                Background="#CFE9FF"
                                                BorderBrush="#18344A"
                                                BorderThickness="1"
                                                Foreground="#18344A">
                                            <Viewbox Width="10" Height="10">
                                                <Grid>
                                                    <Rectangle Width="10" Height="2" Fill="#18344A" VerticalAlignment="Center" />
                                                    <Rectangle Width="2" Height="10" Fill="#18344A" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Viewbox>
                                        </Button>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#18344A"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="Add Project" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button x:Name="AddChildHeaderButton"
                                                Width="24"
                                                Height="22"
                                                Margin="0,0,6,0"
                                                Padding="0"
                                                Click="AddChildHeaderButton_OnClick"
                                                Background="#CFF1D6"
                                                BorderBrush="#2E7D32"
                                                BorderThickness="1"
                                                Foreground="#2E7D32">
                                            <Viewbox Width="10" Height="10">
                                                <Grid>
                                                    <Rectangle Width="10" Height="2" Fill="#2E7D32" VerticalAlignment="Center" />
                                                    <Rectangle Width="2" Height="10" Fill="#2E7D32" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Viewbox>
                                        </Button>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#2E7D32"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="Add Chat" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#B8B8B8"
                            BorderThickness="1"
                            Padding="2">
                        <TreeView x:Name="ProjectCollectionsTreeView"
                                  SelectedItemChanged="ProjectCollectionsTreeView_OnSelectedItemChanged"
                                  PreviewKeyDown="ProjectCollectionsTreeView_OnPreviewKeyDown"
                                  Background="#FFFFFF"
                                  BorderThickness="0">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <ToggleButton x:Name="Expander"
                                                              Grid.Row="0"
                                                              Grid.Column="0"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="0,2,2,0"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              Background="#FFFFFF"
                                                              BorderBrush="#7A7A7A"
                                                              BorderThickness="1"
                                                              Focusable="False">
                                                    <TextBlock x:Name="ExpanderGlyph"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#444444"
                                                               Text="+" />
                                                </ToggleButton>

                                                <Border Grid.Row="0"
                                                        x:Name="SelectionBorder"
                                                        Grid.Column="1"
                                                        Background="Transparent">
                                                    <ContentPresenter ContentSource="Header" />
                                                </Border>

                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Margin="14,0,0,0" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ExpanderGlyph" Property="Text" Value="+" />
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ExpanderGlyph" Property="Text" Value="-" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionBorder" Property="Background" Value="#1E7ACC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <HierarchicalDataTemplate DataType="{x:Type local:CollectionItem}"
                                                      ItemsSource="{Binding Threads}">
                                <Grid Margin="2,1,2,1"
                                      PreviewMouseRightButtonDown="TreeNode_OnPreviewMouseRightButtonDown">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename project"
                                                      Click="RenameRootMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="AI Rename project"
                                                      Click="AiRenameRootMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Delete project"
                                                      Click="DeleteRootMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBox x:Name="RootNameEditor"
                                             Margin="2,0,0,0"
                                             Padding="0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             FontWeight="SemiBold"
                                             LostFocus="RootNameEditor_OnLostFocus"
                                             KeyDown="RootNameEditor_OnKeyDown"
                                             Loaded="RootNameEditor_OnLoaded"
                                             Tag="{Binding}"
                                             Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Tag="{Binding}"
                                               Text="{Binding DisplayName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type local:ChatThreadItem}">
                                <Grid Margin="2,1,2,1"
                                      PreviewMouseRightButtonDown="TreeNode_OnPreviewMouseRightButtonDown">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename chat"
                                                      Click="RenameChildMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="AI Rename chat"
                                                      Click="AiRenameChildMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Delete chat"
                                                      Click="DeleteChildMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBox Margin="2,0,0,0"
                                             Padding="0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             LostFocus="ChildNameEditor_OnLostFocus"
                                             KeyDown="ChildNameEditor_OnKeyDown"
                                             Loaded="ChildNameEditor_OnLoaded"
                                             Tag="{Binding}"
                                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Tag="{Binding}"
                                               Text="{Binding Title}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                        </TreeView>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#D6D0C4"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="#FAF8F3"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition x:Name="PromptInputRow" Height="160" MinHeight="120" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#263746"
                                       Text="Working Pane" />
                            <TextBlock x:Name="CenterModeTextBlock"
                                       Margin="0,4,0,0"
                                       Foreground="#5B6770"
                                       FontSize="12"
                                    Text="Each project root on the left is the actual Workspace Memory collection and upload target." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="#5B6770"
                                       FontSize="11"
                                       Text="Model" />
                            <ComboBox x:Name="ModelComboBox"
                                      Margin="0,4,0,0"
                                      Height="32"
                                      Padding="6,4"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Name"
                                      MinWidth="200" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="#5B6770"
                                       FontSize="11"
                                       Text="Retrieval" />
                            <ComboBox x:Name="RetrievalModeComboBox"
                                      Margin="0,4,0,0"
                                      Height="32"
                                      Padding="6,4"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Code"
                                      MinWidth="160"
                                      ToolTip="Choose how chat context is assembled before it reaches the model." />
                        </StackPanel>
                        <Button x:Name="ClearPromptButton"
                                Grid.Column="3"
                                Height="32"
                                Margin="10,0,0,0"
                                Width="52"
                                Padding="0"
                                MinWidth="52"
                                VerticalAlignment="Bottom"
                                Click="ClearPromptButton_OnClick"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTip="Clear prompt">
                            <Viewbox Width="38"
                                     Height="24"
                                     Stretch="Uniform">
                                <Canvas Width="76"
                                        Height="48">
                                    <Path Fill="#C9C9C9"
                                          Data="M22,4 H60 C66.6,4 72,9.4 72,16 V32 C72,38.6 66.6,44 60,44 H22 C18.8,44 15.8,42.7 13.6,40.4 L2.8,29.6 C-0.9,25.9 -0.9,20.1 2.8,16.4 L13.6,5.6 C15.8,3.3 18.8,2 22,2 Z" />
                                    <Path Stroke="#F2F2F2"
                                          StrokeThickness="4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M34,16 L50,32 M50,16 L34,32" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="AskButton"
                                Grid.Column="4"
                                Height="32"
                                Margin="10,0,0,0"
                                Width="52"
                                Padding="0"
                                MinWidth="52"
                                VerticalAlignment="Bottom"
                                Click="AskButton_OnClick"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTip="Ask">
                            <Viewbox Width="28"
                                     Height="28"
                                     Stretch="Uniform">
                                <Canvas Width="64"
                                        Height="64">
                                    <Path Fill="#6E7CA0"
                                          Data="M6,10 L56,30 C58.7,31.1 58.7,34.9 56,36 L6,56 C3.5,57 1,55 1.4,52.2 L5.6,34 L1.4,13.8 C1,11 3.5,9 6,10 Z" />
                                    <Path Stroke="#F5F7FB"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M11,33 H28 M11,33 L47,20 M11,33 L47,44" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="#F3EFE7"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="PromptTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="120"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="16"
                                     SpellCheck.IsEnabled="True"
                                     GotFocus="PromptTextBox_OnFocusChanged"
                                     LostFocus="PromptTextBox_OnFocusChanged"
                                     PreviewKeyDown="PromptTextBox_OnPreviewKeyDown"
                                     TextChanged="PromptTextBox_OnTextChanged" />
                            <TextBlock x:Name="PromptPlaceholderTextBlock"
                                       Margin="2,2,0,0"
                                       Foreground="#7A7A7A"
                                       FontSize="16"
                                       IsHitTestVisible="False"
                                       Text="Type a prompt." />
                            <TextBlock x:Name="ContextBudgetTextBlock"
                                       Grid.Row="1"
                                       Margin="0,10,0,0"
                                       Foreground="#5B6770"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="Context budget will appear here once there is a prompt and a selected collection." />
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="3"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#D6D0C4"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows"
                                  ShowsPreview="True" />

                    <Grid Grid.Row="5">
                        <Grid.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F3EFE7" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Padding" Value="14" />
                            </Style>
                        </Grid.Resources>

                        <Border x:Name="WorkPanel">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="CollectionHeaderTextBlock"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               Foreground="#18344A"
                                               Text="Project Collection" />
                                    <TextBlock x:Name="CollectionDetailTextBlock"
                                               Margin="0,6,0,0"
                                               FontSize="13"
                                               Foreground="#5B6770"
                                               TextWrapping="Wrap"
                                               Text="Select a project collection on the left to upload content and chat against short memory plus optional durable domain context." />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel x:Name="RootUploadPanel"
                                                Grid.Row="0"
                                                Visibility="Collapsed">
                                        <Button x:Name="UploadButton"
                                                Height="32"
                                                Padding="12,5"
                                                MinWidth="72"
                                                Click="UploadButton_OnClick"
                                                Content="Upload" />
                                        <TextBlock x:Name="UploadStatusTextBlock"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#5B6770"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                    </StackPanel>

                                    <Border Grid.Row="2"
                                            x:Name="RootContentPanel"
                                            Background="#FAF8F3"
                                            BorderBrush="#D6D0C4"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="Collapsed">
                                        <ScrollViewer x:Name="RootContentScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MouseWheel="RootContentScrollViewer_OnMouseWheel">
                                            <StackPanel Margin="12">
                                                <Border
                                                        Background="#FFFFFF"
                                                        BorderBrush="#D6D0C4"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="14">
                                                    <StackPanel>
                                                        <TextBlock FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#263746"
                                                                   Text="Uploads And Chunks" />
                                                        <ListBox Margin="0,8,0,0"
                                                                 x:Name="CollectionContentsListBox"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 HorizontalContentAlignment="Stretch"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                 ScrollViewer.CanContentScroll="False">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type local:DocumentListItem}">
                                                                    <Expander IsExpanded="{Binding IsExpanded}"
                                                                              HorizontalContentAlignment="Stretch"
                                                                              Expanded="DocumentExpander_OnExpanded"
                                                                              Margin="0,0,0,8">
                                                                        <Expander.Header>
                                                                            <Grid HorizontalAlignment="Stretch">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="#4B5560"
                                                                                           Text="" />
                                                                                <TextBlock Grid.Column="1"
                                                                                           VerticalAlignment="Center"
                                                                                           FontWeight="SemiBold"
                                                                                           TextWrapping="Wrap">
                                                                                    <Run Text="{Binding SourceName}" />
                                                                                    <Run Text=" (" />
                                                                                    <Run Text="{Binding ContentUnitCount}" />
                                                                                    <Run Text=" chunks)" />
                                                                                </TextBlock>
                                                                                <Button Grid.Column="2"
                                                                                        MinWidth="74"
                                                                                        Height="28"
                                                                                        Margin="10,0,0,0"
                                                                                        Padding="8,2"
                                                                                        Tag="{Binding}"
                                                                                        Click="CopyDocumentTextButton_OnClick"
                                                                                        Content="Copy Text"
                                                                                        ToolTip="Copy full extracted text" />
                                                                                <Button Grid.Column="3"
                                                                                        MinWidth="74"
                                                                                        Height="28"
                                                                                        Margin="8,0,0,0"
                                                                                        Padding="8,2"
                                                                                        Tag="{Binding}"
                                                                                        Click="SaveDocumentTextButton_OnClick"
                                                                                        Content="Save Text"
                                                                                        ToolTip="Save full extracted text to a file" />
                                                                                <Button Grid.Column="4"
                                                                                        Width="28"
                                                                                        Height="28"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Center"
                                                                                        Margin="8,0,0,0"
                                                                                        Padding="0"
                                                                                        Tag="{Binding}"
                                                                                        Click="DeleteDocumentButton_OnClick"
                                                                                        ToolTip="Delete document"
                                                                                        Background="Transparent"
                                                                                        BorderThickness="0">
                                                                                    <Viewbox Width="14"
                                                                                             Height="14">
                                                                                        <Path Stroke="#C62828"
                                                                                              StrokeThickness="2.2"
                                                                                              StrokeStartLineCap="Round"
                                                                                              StrokeEndLineCap="Round"
                                                                                              Data="M 2 2 L 12 12 M 12 2 L 2 12" />
                                                                                        </Viewbox>
                                                                                </Button>
                                                                            </Grid>
                                                                        </Expander.Header>
                                                                        <ScrollViewer MaxHeight="260"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                                      PreviewMouseWheel="ChunkScrollViewer_OnPreviewMouseWheel">
                                                                            <ItemsControl ItemsSource="{Binding Chunks}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate DataType="{x:Type local:ContentUnitListItem}">
                                                                                        <Border Margin="12,6,0,0"
                                                                                                Padding="8"
                                                                                                Background="#FFFFFF"
                                                                                                BorderBrush="#D6D0C4"
                                                                                                BorderThickness="1">
                                                                                            <Grid>
                                                                                                <Grid.RowDefinitions>
                                                                                                    <RowDefinition Height="Auto" />
                                                                                                    <RowDefinition Height="Auto" />
                                                                                                </Grid.RowDefinitions>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*" />
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock FontWeight="SemiBold"
                                                                                                           Text="{Binding UnitOrdinal, StringFormat=Chunk {0}}" />
                                                                                                <Button Grid.Column="1"
                                                                                                        Width="22"
                                                                                                        Height="22"
                                                                                                        Padding="0"
                                                                                                        Tag="{Binding}"
                                                                                                        Click="DeleteChunkButton_OnClick"
                                                                                                        ToolTip="Delete chunk"
                                                                                                        Background="Transparent"
                                                                                                        BorderThickness="0">
                                                                                                    <Viewbox Width="12"
                                                                                                             Height="12">
                                                                                                        <Path Stroke="#C62828"
                                                                                                              StrokeThickness="2"
                                                                                                              StrokeStartLineCap="Round"
                                                                                                              StrokeEndLineCap="Round"
                                                                                                              Data="M 2 2 L 10 10 M 10 2 L 2 10" />
                                                                                                    </Viewbox>
                                                                                                </Button>
                                                                                                <TextBlock Grid.Row="1"
                                                                                                           Grid.ColumnSpan="2"
                                                                                                           Margin="0,6,0,0"
                                                                                                           TextWrapping="Wrap"
                                                                                                           Foreground="#4B5560"
                                                                                                           Text="{Binding BodyText}" />
                                                                                            </Grid>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>
                                                                    </Expander>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>

                                    <Border Grid.Row="2"
                                            x:Name="ChildResponsePanel"
                                            Background="#FFFFFF"
                                            BorderBrush="#D6D0C4"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#263746"
                                                           Text="Response Surface" />
                                                <Button x:Name="SaveThreadButton"
                                                        Grid.Column="1"
                                                        Width="38"
                                                        Height="38"
                                                        Padding="0"
                                                        Click="SaveThreadButton_OnClick"
                                                        ToolTip="Save the whole chat thread as DOCX or HTML"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#D6DCE5"
                                                        BorderThickness="1">
                                                    <Viewbox Width="20"
                                                             Height="20">
                                                        <Canvas Width="20"
                                                                Height="20">
                                                            <Rectangle Canvas.Left="4"
                                                                       Canvas.Top="3"
                                                                       Width="9"
                                                                       Height="11"
                                                                       RadiusX="1.5"
                                                                       RadiusY="1.5"
                                                                       Stroke="#315B73"
                                                                       StrokeThickness="1.5"
                                                                       Fill="#F3F6FA" />
                                                            <Rectangle Canvas.Left="7"
                                                                       Canvas.Top="5"
                                                                       Width="9"
                                                                       Height="11"
                                                                       RadiusX="1.5"
                                                                       RadiusY="1.5"
                                                                       Stroke="#315B73"
                                                                       StrokeThickness="1.5"
                                                                       Fill="#FFFFFF" />
                                                            <Path Data="M 11.5 8.5 L 11.5 13 M 9.5 11 L 11.5 13 L 13.5 11 M 8 15.5 H 15"
                                                                  Stroke="#315B73"
                                                                  StrokeThickness="1.7"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                            <Border Grid.Row="2"
                                                    Background="#F8F6F1"
                                                    BorderBrush="#E2DBCF"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="0"
                                                    ClipToBounds="True">
                                                <wv2:WebView2 x:Name="ResponseWebView" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="4"
                                           x:Name="IncludedContextTextBlock"
                                           Foreground="#5B6770"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="No durable domains selected." />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#D6D0C4"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Border Grid.Column="4"
                    Background="#FAF8F3"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#263746"
                                   Text="Capability Domains" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#5B6770"
                                   FontSize="12"
                                   Text="Select optional capability-domain context to include with the prompt." />
                    </StackPanel>

                    <TreeView Grid.Row="2"
                              x:Name="DomainContextTreeView"
                              Background="Transparent"
                              BorderThickness="0">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                            <HierarchicalDataTemplate DataType="{x:Type local:DomainItem}" ItemsSource="{Binding TreeChildren}">
                                <CheckBox Content="{Binding DisplayName}"
                                          FontWeight="SemiBold"
                                          IsThreeState="True"
                                          IsChecked="{Binding IsIncluded}"
                                          Checked="ContextCheckBox_OnChanged"
                                          Unchecked="ContextCheckBox_OnChanged"
                                          Indeterminate="ContextCheckBox_OnChanged" />
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type local:CollectionItem}">
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsIncluded}"
                                          Checked="ContextCheckBox_OnChanged"
                                          Unchecked="ContextCheckBox_OnChanged" />
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
