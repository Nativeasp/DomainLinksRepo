<Window x:Class="DomainLinksDesktop.DocumentTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Text"
        Height="720"
        Width="960"
        MinHeight="520"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#F3F1EC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#263746"
                   Text="Document" />

        <TextBox Grid.Row="2"
                 x:Name="DocumentNameTextBox"
                 Height="34"
                 Padding="8,6"
                 VerticalContentAlignment="Center"
                 Background="#FFFFFF"
                 BorderBrush="#CDBFAF"
                 BorderThickness="1" />

        <TextBox Grid.Row="4"
                 x:Name="BodyTextBox"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 Padding="10"
                 Background="#FFFFFF"
                 BorderBrush="#CDBFAF"
                 BorderThickness="1" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="108"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="CancelButton_OnClick"
                    Content="Close" />
            <Button x:Name="SaveButton"
                    Width="108"
                    Height="34"
                    Click="SaveButton_OnClick"
                    Background="#18344A"
                    Foreground="#FFFFFF"
                    Content="Save" />
        </StackPanel>
    </Grid>
</Window>
