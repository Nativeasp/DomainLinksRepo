<Window x:Class="DomainLinksDesktop.DomainLinksBrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DomainLinks Brain"
        Width="1380"
        Height="860"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#F3F1EC">
    <Grid>
        <wv2:WebView2 x:Name="BrainWebView" />
        <Border x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24,16"
                CornerRadius="10"
                Background="#F7F3EA"
                BorderBrush="#CFC7B8"
                BorderThickness="1">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#18344A"
                           Text="Loading DomainLinks Brain…" />
                <TextBlock x:Name="LoadingDetailText"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#5B6770"
                           Text="Connecting to knowledge resources" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
