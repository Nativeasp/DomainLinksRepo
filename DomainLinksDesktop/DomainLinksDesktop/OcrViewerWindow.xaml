<Window x:Class="DomainLinksDesktop.OcrViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="OCR Viewer"
        Height="860"
        Width="1340"
        MinHeight="700"
        MinWidth="1040"
        Background="#F3F1EC"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#18344A"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#F7F3EA"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="OCR Viewer" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#D7E2EA"
                               FontSize="12"
                               Text="Standalone DeepSeek OCR tool for local PDFs and images. This viewer does not import documents into DomainLinks." />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="OpenFileButton"
                            Width="92"
                            Margin="0,0,8,0"
                            Click="OpenFileButton_OnClick"
                            Content="Open File" />
                    <Button x:Name="RunOcrButton"
                            Width="88"
                            Margin="0,0,8,0"
                            Click="RunOcrButton_OnClick"
                            Content="Run OCR" />
                    <Button x:Name="RetryButton"
                            Width="76"
                            Margin="0,0,8,0"
                            Click="RetryButton_OnClick"
                            Content="Retry" />
                    <Button Width="70"
                            Click="CloseButton_OnClick"
                            Content="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PreviewColumn" Width="1.15*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#18344A"
                                   Text="Preview" />
                        <TextBlock x:Name="SelectedFileTextBlock"
                                   Margin="0,4,0,0"
                                   Foreground="#556A7A"
                                   Text="No file selected." />
                    </StackPanel>
                    <Border Grid.Row="2"
                            Background="#F8F6F0"
                            BorderBrush="#D8D2C7"
                            BorderThickness="1"
                            CornerRadius="4">
                        <wv2:WebView2 x:Name="PreviewWebView" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#D6D0C4"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#18344A"
                               Text="Extracted Text" />
                    <TextBlock x:Name="EngineTextBlock"
                               Grid.Row="2"
                               Foreground="#556A7A"
                               Text="Engine: deepseek-ocr:3b" />
                    <TextBox x:Name="ExtractedTextTextBox"
                             Grid.Row="4"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True" />
                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CopyTextButton"
                                Width="84"
                                Margin="0,0,8,0"
                                Click="CopyTextButton_OnClick"
                                Content="Copy Text" />
                        <Button x:Name="SaveTextButton"
                                Width="84"
                                Click="SaveTextButton_OnClick"
                                Content="Save Text" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="#E8EFF5"
                BorderBrush="#C7D2DB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="StatusTextBox"
                         Foreground="#23435A"
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="44"
                         MaxHeight="110"
                         Text="Select a PDF or image to begin." />
                <Button x:Name="CopyStatusButton"
                        Grid.Column="1"
                        Width="86"
                        Height="30"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Click="CopyStatusButton_OnClick"
                        Content="Copy Note" />
            </Grid>
        </Border>
    </Grid>
</Window>
