<UserControl x:Class="DomainLinksDesktop.DomainPolicyDraftTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DomainLinksDesktop"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D6D0C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <DataTemplate x:Key="PolicyLineItemTemplate">
            <Border Margin="0,10,0,0"
                    Padding="10"
                    CornerRadius="6"
                    BorderBrush="#E2DBCF"
                    BorderThickness="1"
                    Background="{Binding StatusBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontSize="10"
                                   Foreground="{Binding StatusForeground}"
                                   FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="72"
                                 Padding="8"
                                 Background="#FFFFFF"
                                 BorderBrush="#D6D0C4"
                                 BorderThickness="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Top">
                        <Button Height="28"
                                Margin="0,0,0,6"
                                Click="AcceptLineButton_OnClick"
                                Tag="{Binding}"
                                Content="Accept" />
                        <Button Height="28"
                                Margin="0,0,0,6"
                                Click="RejectLineButton_OnClick"
                                Tag="{Binding}"
                                Content="Reject" />
                        <Button Height="28"
                                Click="RetryLineButton_OnClick"
                                Tag="{Binding}"
                                Content="Retry" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#263746"
                       Text="Policy Draft" />
            <TextBlock x:Name="PolicyBranchSummaryTextBlock"
                       Margin="0,4,0,0"
                       Foreground="#5B6770"
                       FontSize="12"
                       Text="Select a domain, then click Draft Policy." />
            <TextBlock x:Name="PolicyModelTextBlock"
                       Margin="0,4,0,0"
                       Foreground="#5B6770"
                       FontSize="11"
                       Text="Model used: --" />
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#263746"
                                   Text="Objectives" />
                        <ItemsControl ItemsSource="{Binding ObjectiveItems, RelativeSource={RelativeSource AncestorType=local:DomainPolicyDraftTab}}">
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="PolicyLineItemTemplate" />
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#263746"
                                   Text="Principles" />
                        <ItemsControl ItemsSource="{Binding PrincipleItems, RelativeSource={RelativeSource AncestorType=local:DomainPolicyDraftTab}}">
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="PolicyLineItemTemplate" />
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SectionBorderStyle}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="#263746"
                                       Text="Accountability" />
                            <ItemsControl ItemsSource="{Binding AccountabilityItems, RelativeSource={RelativeSource AncestorType=local:DomainPolicyDraftTab}}">
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="PolicyLineItemTemplate" />
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource SectionBorderStyle}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="#263746"
                                       Text="Transparency" />
                            <ItemsControl ItemsSource="{Binding TransparencyItems, RelativeSource={RelativeSource AncestorType=local:DomainPolicyDraftTab}}">
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="PolicyLineItemTemplate" />
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#263746"
                                   Text="Strategy" />
                        <ItemsControl ItemsSource="{Binding StrategyItems, RelativeSource={RelativeSource AncestorType=local:DomainPolicyDraftTab}}">
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="PolicyLineItemTemplate" />
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#263746"
                                   Text="Policy Statements By Control" />
                        <ItemsControl ItemsSource="{Binding ControlGroups, RelativeSource={RelativeSource AncestorType=local:DomainPolicyDraftTab}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,10,0,0"
                                            Padding="10"
                                            CornerRadius="6"
                                            BorderBrush="#E2DBCF"
                                            BorderThickness="1"
                                            Background="#F8F6F1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ControlName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#263746" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="#5B6770"
                                                       Text="{Binding DetailLine}" />
                                            <ItemsControl ItemsSource="{Binding Statements}">
                                                <ItemsControl.ItemTemplate>
                                                    <StaticResource ResourceKey="PolicyLineItemTemplate" />
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#263746"
                                   Text="Consequences" />
                        <ItemsControl ItemsSource="{Binding ConsequenceItems, RelativeSource={RelativeSource AncestorType=local:DomainPolicyDraftTab}}">
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="PolicyLineItemTemplate" />
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3"
                   x:Name="PolicyStatusTextBlock"
                   Margin="0,8,0,0"
                   Foreground="#5B6770"
                   FontSize="12"
                   Text="Policy drafting idle." />
    </Grid>
</UserControl>
