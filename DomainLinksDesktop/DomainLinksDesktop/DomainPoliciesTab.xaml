<UserControl x:Class="DomainLinksDesktop.DomainPoliciesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DomainLinksDesktop"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#263746"
                           Text="Policies" />
                <TextBlock x:Name="PoliciesSummaryTextBlock"
                           Margin="0,4,0,0"
                           Foreground="#5B6770"
                           FontSize="12"
                           Text="All saved policies across all domains." />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="RefreshPoliciesButton"
                    Width="86"
                    Height="32"
                    Click="RefreshPoliciesButton_OnClick"
                    Content="Refresh" />
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#D6D0C4"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <DataGrid x:Name="PoliciesDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      ItemsSource="{Binding Policies, RelativeSource={RelativeSource AncestorType=local:DomainPoliciesTab}}"
                      SelectionMode="Single"
                      MouseDoubleClick="PoliciesDataGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Policy"
                                        Width="2.1*"
                                        Binding="{Binding PolicyTitle}" />
                    <DataGridTextColumn Header="Domain"
                                        Width="1.5*"
                                        Binding="{Binding RootDomainName}" />
                    <DataGridTextColumn Header="Code"
                                        Width="1.5*"
                                        Binding="{Binding PolicyCode}" />
                    <DataGridTextColumn Header="Version"
                                        Width="0.8*"
                                        Binding="{Binding VersionText}" />
                    <DataGridTextColumn Header="Status"
                                        Width="0.8*"
                                        Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Template"
                                        Width="1.5*"
                                        Binding="{Binding TemplateName}" />
                    <DataGridTextColumn Header="Model"
                                        Width="1.2*"
                                        Binding="{Binding SourceModelName}" />
                    <DataGridTextColumn Header="Sections"
                                        Width="0.8*"
                                        Binding="{Binding SectionCount}" />
                    <DataGridTextColumn Header="Principles"
                                        Width="0.8*"
                                        Binding="{Binding PrincipleCount}" />
                    <DataGridTextColumn Header="Control Lines"
                                        Width="0.9*"
                                        Binding="{Binding ControlStatementCount}" />
                    <DataGridTextColumn Header="Updated"
                                        Width="1.2*"
                                        Binding="{Binding UpdatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="PoliciesStatusTextBlock"
                   Margin="0,8,0,0"
                   Foreground="#5B6770"
                   FontSize="12"
                   Text="Policies idle." />
    </Grid>
</UserControl>
