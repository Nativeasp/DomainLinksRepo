<Window x:Class="DomainLinksDesktop.PolicyPresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Policy Presentation"
        Height="860"
        Width="1180"
        MinHeight="700"
        MinWidth="900"
        Background="#F3F1EC"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#18344A"
                CornerRadius="8"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleTextBlock"
                               Foreground="#F7F3EA"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="Policy Presentation" />
                    <TextBlock x:Name="SubtitleTextBlock"
                               Margin="0,4,0,0"
                               Foreground="#D7E2EA"
                               FontSize="12"
                               Text="Saved policy view" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="88"
                        Height="32"
                        Click="CloseButton_OnClick"
                        Content="Close" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#D6D0C4"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <wv2:WebView2 x:Name="PolicyWebView" />
        </Border>
    </Grid>
</Window>
