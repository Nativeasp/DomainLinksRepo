<UserControl x:Class="DomainLinksDesktop.DomainPolicyWorkspaceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DomainLinksDesktop"
             Background="Transparent">
    <UserControl.Resources>
        <GroupStyle x:Key="ControlGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Border Margin="0,10,0,4"
                            Padding="8,6"
                            Background="#F1ECE2"
                            BorderBrush="#DDD3C3"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#5C6770"
                                   Text="{Binding Name}" />
                    </Border>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#263746"
                           Text="Policy Workspace" />
                <TextBlock x:Name="WorkspaceSummaryTextBlock"
                           Margin="0,4,0,0"
                           Foreground="#5B6770"
                           FontSize="12"
                           Text="Select a domain to work with policies." />
            </StackPanel>
            <WrapPanel Grid.Column="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Orientation="Horizontal">
                <Button x:Name="DraftPolicyButton"
                        MinWidth="112"
                        Margin="0,0,10,10"
                        Click="DraftPolicyButton_OnClick"
                        Content="Draft Policy" />
                <Button x:Name="SavePolicyButton"
                        MinWidth="92"
                        Margin="0,0,10,10"
                        Click="SavePolicyButton_OnClick"
                        Content="Save Draft" />
                <Button x:Name="ClearPolicyTestDataButton"
                        MinWidth="150"
                        Margin="0,0,0,10"
                        Click="ClearPolicyTestDataButton_OnClick"
                        Content="Clear Policy Test Data" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspacePoliciesColumn" Width="430" MinWidth="280" />
                <ColumnDefinition x:Name="WorkspaceColumnSplitterColumn" Width="8" />
                <ColumnDefinition x:Name="DraftPanelColumn" Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition x:Name="PolicyListRow" Height="*" MinHeight="140" />
                        <RowDefinition Height="8" />
                        <RowDefinition x:Name="ControlSelectionRow" Height="220" MinHeight="140" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#263746"
                                   Text="Policies For Selected Domain" />
                        <TextBlock x:Name="PolicyListSummaryTextBlock"
                                   Margin="0,4,0,0"
                                   Foreground="#5B6770"
                                   FontSize="11"
                                   Text="No domain selected." />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="32"
                            Height="28"
                            Padding="0"
                            ToolTip="Delete selected policy version"
                            Click="DeleteSelectedPolicyButton_OnClick">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="&#xE74D;" />
                    </Button>

                    <DataGrid Grid.Row="2"
                              x:Name="PoliciesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              SelectionChanged="PoliciesDataGrid_OnSelectionChanged"
                              MouseDoubleClick="PoliciesDataGrid_OnMouseDoubleClick"
                              ItemsSource="{Binding Policies, RelativeSource={RelativeSource AncestorType=local:DomainPolicyWorkspaceTab}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Policy"
                                                Width="2.2*"
                                                Binding="{Binding PolicyTitle}" />
                            <DataGridTextColumn Header="Code"
                                                Width="1.4*"
                                                Binding="{Binding PolicyCode}" />
                            <DataGridTextColumn Header="Version"
                                                Width="0.8*"
                                                Binding="{Binding VersionText}" />
                            <DataGridTextColumn Header="Status"
                                                Width="0.8*"
                                                Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Controls"
                                                Width="0.9*"
                                                Binding="{Binding ControlStatementCount}" />
                            <DataGridTextColumn Header="Updated"
                                                Width="1.2*"
                                                Binding="{Binding UpdatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="3"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#D6D0C4"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows"
                                  ShowsPreview="True" />

                    <Border Grid.Row="4"
                            Background="#F8F6F1"
                            BorderBrush="#E2DBCF"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True"
                            Padding="10">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#263746"
                                               Text="Controls In This Policy" />
                                    <TextBlock x:Name="ControlSelectionSummaryTextBlock"
                                               Margin="0,4,0,0"
                                               Foreground="#5B6770"
                                               FontSize="11"
                                               Text="Select a domain to choose controls." />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        MinWidth="72"
                                        Height="28"
                                        Click="SelectAllControlsButton_OnClick"
                                        Content="All" />
                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           Foreground="#5B6770"
                                           FontSize="11"
                                           Text="Group" />
                                <ComboBox Grid.Column="5"
                                          x:Name="ControlGroupingComboBox"
                                          Width="140"
                                          Height="28"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="ControlGroupingComboBox_OnSelectionChanged"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Code"
                                          ItemsSource="{Binding ControlGroupingModes, RelativeSource={RelativeSource AncestorType=local:DomainPolicyWorkspaceTab}}" />
                                <Button Grid.Column="9"
                                        MinWidth="72"
                                        Height="28"
                                        Click="ClearControlsButton_OnClick"
                                        Content="None" />
                            </Grid>

                            <ListBox Grid.Row="2"
                                     x:Name="SelectableControlsListBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     SelectionMode="Extended"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     PreviewKeyDown="SelectableControlsListBox_OnPreviewKeyDown"
                                     ItemsSource="{Binding SelectableControlsView, RelativeSource={RelativeSource AncestorType=local:DomainPolicyWorkspaceTab}}">
                                <ListBox.GroupStyle>
                                    <StaticResource ResourceKey="ControlGroupStyle" />
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,6"
                                                BorderBrush="#ECE6DB"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Margin="0,2,10,0"
                                                          VerticalAlignment="Top"
                                                          IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="#263746"
                                                               Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="#5B6770"
                                                               Text="{Binding DetailLine}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          x:Name="WorkspaceColumnSplitter"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#D6D0C4"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <local:DomainPolicyDraftTab Grid.Column="2"
                                        Margin="10,0,0,0"
                                        x:Name="DraftTabContent" />
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="WorkspaceStatusTextBlock"
                   Margin="0,8,0,0"
                   Foreground="#5B6770"
                   FontSize="12">
            <Run x:Name="WorkspaceStatusBaseRun"
                 Text="Policy workspace idle" />
            <Run x:Name="WorkspaceStatusDotsRun"
                 Foreground="#B22222"
                 Text="." />
        </TextBlock>
    </Grid>
</UserControl>
