<Window x:Class="DomainLinksDesktop.DomainStoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DomainLinksDesktop"
        Title="Domain Store"
        Height="860"
        Width="1500"
        MinHeight="720"
        MinWidth="1180"
        WindowStartupLocation="CenterOwner"
        Background="#F3F1EC">
    <Window.Resources>
        <Style x:Key="CopyableLabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="MouseLeftButtonUp" Handler="StaticLabelTextBlock_OnMouseLeftButtonUp" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#22384A" />
            <Setter Property="Background" Value="#F6F2E9" />
            <Setter Property="BorderBrush" Value="#CFC7B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEE7DA" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#BEB19D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E3DACB" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#AA9B84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SplitterToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4A5863" />
            <Setter Property="Background" Value="#F4F1EA" />
            <Setter Property="BorderBrush" Value="#CFC7B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAE4D8" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#BFB5A3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DFD7C9" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#AFA28B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DomainStoreTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#ECE7DD" />
            <Setter Property="BorderBrush" Value="#D6D0C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,6,-1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#D6D0C4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#18344A"
                CornerRadius="8"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="#F7F3EA"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Style="{StaticResource CopyableLabelTextBlockStyle}"
                               Text="Domain Store" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#D7E2EA"
                               FontSize="12"
                               Style="{StaticResource CopyableLabelTextBlockStyle}"
                               Text="Manage domain trees, context text, collections, and retrieval-ready documents." />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="RefreshButton"
                            Width="88"
                            Height="32"
                            Margin="0,0,10,0"
                            Click="RefreshButton_OnClick"
                            Content="Refresh" />
                    <Button x:Name="CloseButton"
                            Width="88"
                            Height="32"
                            Click="CloseButton_OnClick"
                            Content="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DomainTreeColumn" Width="300" MinWidth="240" />
                <ColumnDefinition x:Name="DomainTreeSplitterColumn" Width="18" />
                <ColumnDefinition x:Name="SummaryColumn" Width="500" MinWidth="360" />
                <ColumnDefinition x:Name="CollectionsSplitterColumn" Width="18" />
                <ColumnDefinition x:Name="CollectionsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FAF8F3"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#263746"
                                   Style="{StaticResource CopyableLabelTextBlockStyle}"
                                   Text="Domain Tree" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#5B6770"
                                   FontSize="12"
                                   Style="{StaticResource CopyableLabelTextBlockStyle}"
                                   Text="Create and shape domain hierarchies for long-term RAG context." />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <Button Width="96"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Click="AddSharedRootButton_OnClick"
                                    Content="Add Type" />
                            <Button Width="96"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Click="AddClientRootButton_OnClick"
                                    Visibility="Collapsed"
                                    Content="Add Client" />
                            <Button Width="86"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Click="AddChildButton_OnClick"
                                    Content="Add Child" />
                            <Button Width="76"
                                    Height="30"
                                    Click="DeleteDomainButton_OnClick"
                                    Content="Delete" />
                        </StackPanel>
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             x:Name="DomainSearchTextBox"
                             Height="34"
                             Padding="10,6"
                             VerticalContentAlignment="Center"
                             TextChanged="DomainSearchTextBox_OnTextChanged"
                             ToolTip="Search domains by name, code, type, or description" />

                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#D6D0C4"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                            <Grid>
                            <Grid.Resources>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <EventSetter Event="PreviewMouseRightButtonDown"
                                                 Handler="DomainTreeViewItem_OnPreviewMouseRightButtonDown" />
                                </Style>
                                <HierarchicalDataTemplate DataType="{x:Type local:DomainItem}"
                                                          ItemsSource="{Binding ChildDomains}">
                                    <Border Padding="6,5"
                                            Margin="0,1,0,1"
                                            CornerRadius="4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Text="{Binding TreeMetaText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Foreground" Value="#434A45" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TreeMetaText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True" />
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=(Selector.IsSelectionActive)}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#4C5F6B"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="14"
                                                       Text="{Binding IconGlyph}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconGlyph}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock VerticalAlignment="Center"
                                                       Cursor="Hand"
                                                       FontWeight="SemiBold"
                                                       MouseLeftButtonUp="DomainLabelTextBlock_OnMouseLeftButtonUp"
                                                       Text="{Binding DisplayName}" />
                                        </DockPanel>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </Grid.Resources>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="DomainTreeSummaryTextBlock"
                                       FontSize="12"
                                       Foreground="#5B6770"
                                       Style="{StaticResource CopyableLabelTextBlockStyle}"
                                       Text="Domains 0 | Collections 0 | Policies 0 | Controls 0" />

                            <TreeView Grid.Row="2"
                                      x:Name="SharedDomainTreeView"
                                      AllowDrop="True"
                                      SelectedItemChanged="DomainTreeView_OnSelectedItemChanged"
                                      PreviewMouseLeftButtonDown="DomainTreeView_OnPreviewMouseLeftButtonDown"
                                      MouseMove="DomainTreeView_OnMouseMove"
                                      DragOver="DomainTreeView_OnDragOver"
                                      Drop="DomainTreeView_OnDrop"
                                      PreviewKeyDown="DomainTreeView_OnPreviewKeyDown"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <TreeView.ContextMenu>
                                    <ContextMenu Opened="DomainTreeItemContextMenu_OnOpened">
                                        <MenuItem Header="Isolate Branch"
                                                  Click="IsolateBranchMenuItem_OnClick" />
                                        <MenuItem Header="Save Branch To Clipboard"
                                                  Click="SaveBranchToClipboardMenuItem_OnClick" />
                                        <MenuItem Header="Show Full Tree"
                                                  Click="ShowFullTreeMenuItem_OnClick" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>

                            <TextBlock Grid.Row="4"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#263746"
                                       Visibility="Collapsed"
                                       Style="{StaticResource CopyableLabelTextBlockStyle}"
                                       Text="Client Services" />

                            <TreeView Grid.Row="6"
                                      x:Name="ClientDomainTreeView"
                                      AllowDrop="True"
                                      SelectedItemChanged="DomainTreeView_OnSelectedItemChanged"
                                      PreviewMouseLeftButtonDown="DomainTreeView_OnPreviewMouseLeftButtonDown"
                                      MouseMove="DomainTreeView_OnMouseMove"
                                      DragOver="DomainTreeView_OnDragOver"
                                      Drop="DomainTreeView_OnDrop"
                                      PreviewKeyDown="DomainTreeView_OnPreviewKeyDown"
                                      Visibility="Collapsed"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <TreeView.ContextMenu>
                                    <ContextMenu Opened="DomainTreeItemContextMenu_OnOpened">
                                        <MenuItem Header="Isolate Branch"
                                                  Click="IsolateBranchMenuItem_OnClick" />
                                        <MenuItem Header="Save Branch To Clipboard"
                                                  Click="SaveBranchToClipboardMenuItem_OnClick" />
                                        <MenuItem Header="Show Full Tree"
                                                  Click="ShowFullTreeMenuItem_OnClick" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          x:Name="DomainTreeSplitter"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Button Grid.Column="1"
                    x:Name="ToggleDomainTreeButton"
                    Style="{StaticResource SplitterToggleButtonStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="2"
                    Click="ToggleDomainTreeButton_OnClick"
                    ToolTip="Hide or show the domain tree"
                    Content="◀" />

            <Border Grid.Column="2"
                    Background="#FAF8F3"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <TabControl x:Name="DomainStoreCenterTabControl"
                            Background="Transparent"
                            BorderBrush="#D6D0C4"
                            BorderThickness="0"
                            SelectionChanged="DomainStoreCenterTabControl_OnSelectionChanged">
                    <TabItem x:Name="DomainSummaryTabItem"
                             Header="Domain Summary"
                             Style="{StaticResource DomainStoreTabItemStyle}">
                        <Border Margin="0,0,0,0"
                                Background="#FFFFFF"
                                BorderBrush="#D6D0C4"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="0,0,18,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="#263746"
                                                   Style="{StaticResource CopyableLabelTextBlockStyle}"
                                                   Text="Domain Summary" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="#5B6770"
                                                   FontSize="12"
                                                   Style="{StaticResource CopyableLabelTextBlockStyle}"
                                                   Text="Description is the current domain context text used to shape retrieval." />
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <StackPanel>
                                            <TextBlock Foreground="#5B6770"
                                                       FontSize="11"
                                                       Style="{StaticResource CopyableLabelTextBlockStyle}"
                                                       Text="Display Name" />
                                            <TextBox x:Name="DomainNameTextBox"
                                                     Margin="0,4,0,0"
                                                     Height="34"
                                                     Padding="8,6" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="4">
                                        <TextBlock Foreground="#5B6770"
                                                   FontSize="11"
                                                   Style="{StaticResource CopyableLabelTextBlockStyle}"
                                                   Text="Domain Summary / Context Text" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="#5B6770"
                                                   FontSize="12"
                                                   Style="{StaticResource CopyableLabelTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="Use this description to define what the domain means, what belongs here, and how it should shape retrieval." />
                                        <TextBox x:Name="DomainDescriptionTextBox"
                                                 Margin="0,8,0,0"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 Height="180"
                                                 Padding="10" />
                                    </StackPanel>

                                    <Expander Grid.Row="6"
                                              Header="AI Writing Assist"
                                              IsExpanded="True">
                                        <Border Margin="0,8,0,0"
                                                Padding="10"
                                                Background="#F8F6F1"
                                                BorderBrush="#E2DBCF"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="140" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="120" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Foreground="#5B6770"
                                                           FontSize="12"
                                                           Style="{StaticResource CopyableLabelTextBlockStyle}"
                                                           Text="System prompt: Domain curation assist is active for the selected domain." />

                                                <TextBox Grid.Row="2"
                                                         x:Name="AssistInstructionTextBox"
                                                         Height="34"
                                                         Padding="8,6"
                                                         VerticalContentAlignment="Center"
                                                         Text="Improve this domain wording for retrieval clarity." />

                                                <UniformGrid Grid.Row="4"
                                                             Columns="3">
                                                    <Button Margin="0,0,8,8"
                                                            Padding="10,4"
                                                            Click="AssistQuickActionButton_OnClick"
                                                            Tag="Draft a clean domain description for retrieval."
                                                            Content="Draft Context" />
                                                    <Button Margin="0,0,8,8"
                                                            Padding="10,4"
                                                            Click="AssistQuickActionButton_OnClick"
                                                            Tag="Improve the wording while preserving intent."
                                                            Content="Improve Wording" />
                                                    <Button Margin="0,0,8,8"
                                                            Padding="10,4"
                                                            Click="AssistQuickActionButton_OnClick"
                                                            Tag="Make this shorter and tighter without losing meaning."
                                                            Content="Make Shorter" />
                                                    <Button Margin="0,0,8,8"
                                                            Padding="10,4"
                                                            Click="AssistQuickActionButton_OnClick"
                                                            Tag="Make this more specific about what belongs in this domain."
                                                            Content="More Specific" />
                                                    <Button Margin="0,0,8,8"
                                                            Padding="10,4"
                                                            Click="AssistQuickActionButton_OnClick"
                                                            Tag="Align this wording with the parent and child domain structure."
                                                            Content="Align To Tree" />
                                                </UniformGrid>

                                                <StackPanel Grid.Row="6"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                    <Button x:Name="SuggestChildNodeButton"
                                                            Width="136"
                                                            Height="32"
                                                            Margin="0,0,8,0"
                                                            Click="SuggestChildNodeButton_OnClick"
                                                            IsEnabled="False"
                                                            Content="Suggest Child Node" />
                                                    <Button x:Name="GenerateAssistButton"
                                                            Width="136"
                                                            Height="32"
                                                            Click="GenerateAssistButton_OnClick"
                                                            IsEnabled="False"
                                                            Background="#18344A"
                                                            Foreground="#FFFFFF"
                                                            Content="Generate Suggestion" />
                                                </StackPanel>

                                                <TextBox Grid.Row="8"
                                                         x:Name="AssistResponseTextBox"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Padding="10"
                                                         Background="#FFFFFF"
                                                         BorderBrush="#D6D0C4"
                                                         BorderThickness="1" />

                                                <StackPanel Grid.Row="10"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                    <Button Width="88"
                                                            Height="32"
                                                            Margin="0,0,8,0"
                                                            Click="CopyAssistButton_OnClick"
                                                            Content="Copy" />
                                                    <Button Width="88"
                                                            Height="32"
                                                            Margin="0,0,8,0"
                                                            Click="AppendAssistButton_OnClick"
                                                            Content="Append" />
                                                    <Button Width="96"
                                                            Height="32"
                                                            Click="ReplaceAssistButton_OnClick"
                                                            Content="Replace" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="12"
                                                           Foreground="#5B6770"
                                                           FontSize="11"
                                                           Style="{StaticResource CopyableLabelTextBlockStyle}"
                                                           Text="Suggested Child SQL Preview" />

                                                <TextBox Grid.Row="14"
                                                         x:Name="ChildSqlPreviewTextBox"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Padding="10"
                                                         Background="#FFFFFF"
                                                         BorderBrush="#D6D0C4"
                                                         BorderThickness="1" />

                                                <StackPanel Grid.Row="16"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                    <Button x:Name="CopyChildSqlButton"
                                                            Width="88"
                                                            Height="32"
                                                            Margin="0,0,8,0"
                                                            Click="CopyChildSqlButton_OnClick"
                                                            IsEnabled="False"
                                                            Content="Copy SQL" />
                                                    <Button x:Name="RunChildInsertButton"
                                                            Width="96"
                                                            Height="32"
                                                            Click="RunChildInsertButton_OnClick"
                                                            IsEnabled="False"
                                                            Background="#18344A"
                                                            Foreground="#FFFFFF"
                                                            Content="Run Insert" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Expander>

                                    <StackPanel Grid.Row="8">
                                        <TextBlock Foreground="#5B6770"
                                                   FontSize="11"
                                                   Style="{StaticResource CopyableLabelTextBlockStyle}"
                                                   Text="Domain Stats" />
                                        <TextBlock x:Name="DomainStatsTextBlock"
                                                   Margin="0,4,0,0"
                                                   Foreground="#263746"
                                                   FontWeight="SemiBold"
                                                   Text="Select a domain" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="10"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Width="96"
                                                Height="32"
                                                Margin="0,0,10,0"
                                                Click="RevertDomainButton_OnClick"
                                                Content="Revert" />
                                        <Button Width="96"
                                                Height="32"
                                                Click="SaveDomainButton_OnClick"
                                                Background="#18344A"
                                                Foreground="#FFFFFF"
                                                Content="Save" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem x:Name="ControlsTabItem"
                             Header="Controls"
                             Style="{StaticResource DomainStoreTabItemStyle}">
                        <Border Margin="0,0,0,0"
                                Background="#FFFFFF"
                                BorderBrush="#D6D0C4"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <local:DomainControlsTab x:Name="ControlsTabContent" />
                        </Border>
                    </TabItem>
                    <TabItem x:Name="PolicyWorkspaceTabItem"
                             Header="Policy Workspace"
                             Style="{StaticResource DomainStoreTabItemStyle}">
                        <Border Margin="0,0,0,0"
                                Background="#FFFFFF"
                                BorderBrush="#D6D0C4"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <local:DomainPolicyWorkspaceTab x:Name="PolicyWorkspaceTabContent" />
                        </Border>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="3"
                          x:Name="CollectionsSplitter"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Button Grid.Column="3"
                    x:Name="ToggleCollectionsPanelButton"
                    Style="{StaticResource SplitterToggleButtonStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="2"
                    Click="ToggleCollectionsPanelButton_OnClick"
                    ToolTip="Hide or show the collections and documents panel"
                    Content="▶" />

            <Border Grid.Column="4"
                    Background="#FAF8F3"
                    BorderBrush="#D6D0C4"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14,14,14">
                <Grid Margin="6,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition x:Name="CollectionsPaneRow" Height="220" MinHeight="120" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#263746"
                                       Style="{StaticResource CopyableLabelTextBlockStyle}"
                                       Text="Collections and Documents" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#5B6770"
                                       FontSize="12"
                                       Style="{StaticResource CopyableLabelTextBlockStyle}"
                                       Text="Collections group source corpora, and documents remain directly accessible while feeding retrieval." />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal">
                        <Button Width="118"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="NewCollectionButton_OnClick"
                                Content="New Collection" />
                        <Button Width="122"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="DeleteCollectionButton_OnClick"
                                Content="Delete Collection" />
                        <Button Width="94"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="UploadDocumentButton_OnClick"
                                Content="Upload File" />
                        <Button Width="82"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="AddTextButton_OnClick"
                                Content="Add Text" />
                        <Button Width="88"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="OpenTextButton_OnClick"
                                Content="Open Text" />
                        <Button Width="74"
                                Height="32"
                                Click="DeleteDocumentButton_OnClick"
                                Content="Delete" />
                    </StackPanel>

                    <Border Grid.Row="4"
                            Background="#FFFFFF"
                            BorderBrush="#D6D0C4"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <ListBox x:Name="CollectionsListBox"
                                 SelectionChanged="CollectionsListBox_OnSelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CollectionItem}">
                                    <Border Margin="0,0,0,8"
                                            Padding="10"
                                            Background="#F8F6F1"
                                            BorderBrush="#E2DBCF"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="#263746"
                                                       Text="{Binding DisplayName}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="#5B6770"
                                                       FontSize="11"
                                                       Text="{Binding CollectionCode}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <GridSplitter Grid.Row="5"
                                  Height="12"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#D6D0C4"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows"
                                  ShowsPreview="True" />

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#263746"
                                   Style="{StaticResource CopyableLabelTextBlockStyle}"
                                   Text="Documents" />
                        <TextBlock Grid.Column="1"
                                   x:Name="DocumentScopeTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="#5B6770"
                                   FontSize="12"
                                   Text="No collection selected" />
                    </Grid>

                    <DataGrid Grid.Row="10"
                              x:Name="DocumentsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              MouseDoubleClick="DocumentsDataGrid_OnMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Document"
                                                Width="2*"
                                                Binding="{Binding SourceName}" />
                            <DataGridTextColumn Header="Collection"
                                                Width="1.4*"
                                                Binding="{Binding CollectionCode}" />
                            <DataGridTextColumn Header="Source"
                                                Width="1.1*"
                                                Binding="{Binding SourceType}" />
                            <DataGridTextColumn Header="Embed Status"
                                                Width="1.1*"
                                                Binding="{Binding EmbedStatusDisplay}" />
                            <DataGridTextColumn Header="Updated"
                                                Width="1.2*"
                                                Binding="{Binding UpdatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                            <DataGridTextColumn Header="Chunks"
                                                Width="0.8*"
                                                Binding="{Binding ContentUnitCount}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="StatusTextBlock"
                   Foreground="#5B6770"
                   FontSize="12"
                   Text="Ready." />
    </Grid>
</Window>
